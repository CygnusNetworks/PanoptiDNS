# systemd unit for a non-container deployment.
#
# This replaces AllKnowingDNS's use of Privileges::Drop: systemd binds the
# capability and drops privileges itself, so the process never runs as root and
# needs no privilege-dropping code of its own.

[Unit]
Description=PanoptiDNS — synthesizing IPv6 reverse DNS server
Documentation=man:panoptidns(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/panoptidns --check-config --config /etc/panoptidns/panoptidns.conf
ExecStart=/usr/bin/panoptidns --config /etc/panoptidns/panoptidns.conf
# SIGHUP re-reads the config; a parse error keeps the previous one running.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# Unprivileged, with exactly the one capability needed to bind port 53.
# AmbientCapabilities is the part that matters: without it a non-root process
# gets EACCES even when the capability is in the bounding set.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Nothing is ever written to disk; logs go to the journal via stdout.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# A synthesizing server holds no zone data, so its footprint is bounded by the
# rate-limiter state; this is a backstop, not a tuning knob.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
